# ============================================================
# .gitignore – Lab 1 Series de Tiempo
# ============================================================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Entornos virtuales
venv/
.venv/
env/
.env/
env.bak/
venv.bak/

# Jupyter (no se usan, pero por si acaso)
.ipynb_checkpoints/
*.ipynb

# Datos crudos (archivo grande, no versionar)
data/raw/*.xlsx
data/raw/*.csv
data/raw/*.xls

# Figuras generadas (se regeneran corriendo los scripts)
reports/figures/*.png
reports/figures/*.svg
reports/figures/*.pdf

# IDE / OS
.vscode/
.idea/
*.DS_Store
Thumbs.db

# Archivos temporales
*.log
*.tmp
